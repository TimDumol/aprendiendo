{
  "expo": {
    "name": "Aprendiendo Practice MVP",
    "slug": "aprendiendo-practice-mvp",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "aprendiendo-practice-mvp",
    "android": {
      "package": "com.timdumol.aprendiendo.practice",
      "versionCode": 1
    },
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "./plugins/withAndroidBuildLimits",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Aprendiendo to record your Spanish practice.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aprendiendo to choose a practice image."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "static"
    }
  }
}
