# SQLite database file. The parent directory is created at startup.
DATABASE_PATH=data/aprendiendo.sqlite3
DATABASE_TIMEOUT_SECONDS=10

BIND_ADDR=0.0.0.0:8080
MAX_REQUEST_BYTES=131072
RUST_LOG=aprendiendo_mcp=info

# Production ChatGPT connection: OAuth is issued by Pocket ID and validated here.
AUTH_MODE=oidc
PUBLIC_BASE_URL=https://mars.timdumol.com
OIDC_ISSUER=https://auth.aries.timdumol.com
# Keep this equal to Pocket ID's advertised jwks_uri.
OIDC_JWKS_URL=https://auth.aries.timdumol.com/.well-known/jwks.json
OIDC_AUDIENCE=https://mars.timdumol.com
OIDC_ALLOWED_SUBJECT=replace-with-pocket-id-uuid
OIDC_REQUIRED_SCOPE=learning:access

# Local alternative for clients that support custom Authorization headers:
# AUTH_MODE=bearer
# BEARER_TOKEN=replace-with-a-high-entropy-secret

# Local-only alternative:
# AUTH_MODE=disabled
# BIND_ADDR=127.0.0.1:8080
