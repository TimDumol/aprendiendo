# Use the pooled Neon connection string for normal runtime queries.
DATABASE_URL=postgresql://mcp_runtime:replace-me@ep-example-pooler.us-east-2.aws.neon.tech/spanish_learning?sslmode=require
DATABASE_POOL_SIZE=2
DATABASE_TIMEOUT_SECONDS=10

BIND_ADDR=0.0.0.0:8080
MAX_REQUEST_BYTES=131072
RUST_LOG=aprendiendo_mcp=info

# Production ChatGPT connection: a static bearer token, no identity provider.
# Generate with: openssl rand -base64 32
# Paste the same value in ChatGPT's custom connector ("paste a token").
AUTH_MODE=bearer
BEARER_TOKEN=replace-with-a-high-entropy-secret

# Alternative: OAuth via an external identity provider.
# AUTH_MODE=oidc
# PUBLIC_BASE_URL=https://spanish-mcp.example.com
# OIDC_ISSUER=https://your-tenant.example.com
# OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# OIDC_AUDIENCE=https://spanish-mcp.example.com
# OIDC_ALLOWED_SUBJECT=replace-with-your-oidc-subject
# OIDC_REQUIRED_SCOPE=learning:access

# Local-only alternative:
# AUTH_MODE=disabled
# BIND_ADDR=127.0.0.1:8080
